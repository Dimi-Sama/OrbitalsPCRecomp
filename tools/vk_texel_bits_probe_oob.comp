#version 450
// vk_texel_bits_probe.c oob: invocation i fetches texel i (the last one texel -1) of a 4-texel view and stores the bits
layout(local_size_x = 16) in;
layout(set = 0, binding = 0) uniform samplerBuffer src;
layout(set = 0, binding = 1) buffer Out { uint words[]; };
void main() { uint i = gl_LocalInvocationID.x; int c = i == 15u ? -1 : int(i); words[i] = floatBitsToUint(texelFetch(src, c).x); }
