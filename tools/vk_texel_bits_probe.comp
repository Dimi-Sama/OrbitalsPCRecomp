#version 450
// vk_texel_bits_probe.c: each invocation fetches texel i of a float-typed uniform texel buffer and stores its x component's bits
layout(local_size_x = 16) in;
layout(set = 0, binding = 0) uniform samplerBuffer src;
layout(set = 0, binding = 1) buffer Out { uint words[]; };
void main() { uint i = gl_LocalInvocationID.x; words[i] = floatBitsToUint(texelFetch(src, int(i)).x); }
